<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ScrollPane?>

<BorderPane fx:id="rootPane"
            prefHeight="900.0"
            prefWidth="1500.0"
            stylesheets="@styles.css"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.example.healthappointment.controller.MainController">

    <!-- SIDEBAR -->
    <left>
        <HBox styleClass="side-shell">

            <!-- MENU BUTTON -->
            <VBox alignment="TOP_CENTER" styleClass="menu-rail">
                <padding><Insets bottom="16" left="8" right="8" top="16"/></padding>

                <Button fx:id="hamburgerButton"
                        onAction="#handleToggleSidebar"
                        styleClass="hamburger-btn"
                        accessibleText="Toggle menu"
                        accessibleHelp="Open or close the sidebar menu">

                    <graphic>
                        <VBox alignment="CENTER" spacing="4">
                            <Region fx:id="lineTop" styleClass="hamburger-line"/>
                            <Region fx:id="lineMiddle" styleClass="hamburger-line"/>
                            <Region fx:id="lineBottom" styleClass="hamburger-line"/>
                        </VBox>
                    </graphic>
                </Button>
            </VBox>

            <!-- SIDEBAR CONTENT -->
            <VBox fx:id="sidebar"
                  spacing="14"
                  styleClass="sidebar"
                  visible="false"
                  managed="false"
                  prefWidth="0.0"
                  minWidth="0.0"
                  maxWidth="240.0">

                <padding><Insets bottom="24" left="18" right="18" top="22"/></padding>

                <Label text="Appointment Dashboard"
                       styleClass="sidebar-heading"
                       accessibleText="Dashboard menu"/>

                <Separator/>

                <!-- ADD -->
                <VBox spacing="2">
                    <Button fx:id="btnAdd"
                            text="Add Appointment"
                            onAction="#handleAdd"
                            styleClass="nav-btn"
                            accessibleText="Add appointment"
                            accessibleHelp="Create a new appointment"/>
                    <Region fx:id="underlineAdd" styleClass="nav-underline"/>
                </VBox>

                <!-- EDIT -->
                <VBox spacing="2">
                    <Button fx:id="btnEdit"
                            text="Edit Appointment"
                            onAction="#handleUpdate"
                            styleClass="nav-btn"
                            accessibleText="Edit appointment"
                            accessibleHelp="Edit selected appointment"/>
                    <Region fx:id="underlineEdit" styleClass="nav-underline"/>
                </VBox>

                <!-- DELETE -->
                <VBox spacing="2">
                    <Button fx:id="btnDelete"
                            text="Delete Appointment"
                            onAction="#handleDelete"
                            styleClass="nav-btn"
                            accessibleText="Delete appointment"
                            accessibleHelp="Delete selected appointment"/>
                    <Region fx:id="underlineDelete" styleClass="nav-underline"/>
                </VBox>

                <!-- DETAILS -->
                <VBox spacing="2">
                    <Button fx:id="btnDetails"
                            text="View Details"
                            onAction="#handleViewDetails"
                            styleClass="nav-btn"
                            accessibleText="View details"
                            accessibleHelp="View details of selected appointment"/>
                    <Region fx:id="underlineDetails" styleClass="nav-underline"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>
                <!-- EXIT BUTTON -->
                <VBox spacing="2">
                    <Button fx:id="btnExit"
                            id="exitButton"
                            text="Exit Application"
                            onAction="#handleExit"
                            styleClass="nav-btn"
                            accessibleText="Exit application"
                            accessibleHelp="Close the application"/>
                    <Region fx:id="underlineExit" styleClass="nav-underline"/>
                </VBox>
            </VBox>
        </HBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <StackPane styleClass="top-bar">
            <Label text="HealthCare"
                   styleClass="title"
                   accessibleText="Healthcare dashboard"/>
        </StackPane>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background: transparent;">

            <content>
                <VBox fx:id="contentArea"
                      spacing="15"
                      alignment="TOP_CENTER"
                      styleClass="content-area">

                    <padding><Insets bottom="16" left="16" right="16" top="8"/></padding>

                    <!-- FILTER -->
                    <FlowPane fx:id="filterToolbar"
                              hgap="12"
                              vgap="10"
                              alignment="CENTER"
                              styleClass="card filter-card filter-toolbar">

                        <!-- SEARCH -->
                        <HBox spacing="8" styleClass="search-shell">
                            <TextField fx:id="searchField"
                                       promptText="Search appointments"
                                       styleClass="filter-input"
                                       accessibleText="Search appointments"
                                       accessibleHelp="Type to search appointments"/>
                            <Label text="⌕" styleClass="search-icon"/>
                        </HBox>

                        <!-- DATE -->
                        <HBox spacing="8" styleClass="date-group">
                            <Label text="Pick Date"
                                   styleClass="filter-label"
                                   accessibleText="Select date filter"/>
                            <DatePicker fx:id="filterDate"
                                        styleClass="filter-date"
                                        accessibleText="Filter by date"/>
                        </HBox>

                        <!-- STATUS -->
                        <ComboBox fx:id="filterStatus"
                                  promptText="Appointment Status"
                                  styleClass="filter-status"
                                  accessibleText="Filter by status"/>

                        <!-- CLEAR -->
                        <Button fx:id="clearFilterButton"
                                text="Clear"
                                onAction="#handleClearFilter"
                                styleClass="filter-clear-btn"
                                accessibleText="Clear filters"/>
                    </FlowPane>

                    <!-- TABLE -->
                    <VBox styleClass="card">
                        <TableView fx:id="tableView"
                                   prefHeight="600"
                                   accessibleText="Appointments table"
                                   accessibleHelp="List of all appointments">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>
                                <TableColumn fx:id="colId" text="No."/>
                                <TableColumn fx:id="colPatientName" text="Patient Name"/>
                                <TableColumn fx:id="colPhone" text="Contact"/>
                                <TableColumn fx:id="colDate" text="Date"/>
                                <TableColumn fx:id="colTime" text="Time"/>
                                <TableColumn fx:id="colDoctor" text="Doctor"/>
                                <TableColumn fx:id="colReason" text="Reason"/>
                                <TableColumn fx:id="colStatus" text="Status"/>
                            </columns>
                        </TableView>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>