<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!--
    main-view.fxml  -  Dashboard Screen
    Implements: Section 3 Screen 1, Use Cases 1-5
    Accessibility: high-contrast labels, logical Tab order (Section 7)
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.healthappointment.controller.MainController"
            styleClass="root-pane">

    <!-- ===== Top: MenuBar + Title + Search/Filter bar ==================== -->
    <top>
        <VBox>

            <!-- Menu Bar -->
            <MenuBar styleClass="menu-bar">
                <Menu text="File">
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>
                <Menu text="Appointments">
                    <MenuItem text="Add Appointment"    onAction="#handleAdd"/>
                    <MenuItem text="Edit Appointment"   onAction="#handleUpdate"/>
                    <MenuItem text="Delete Appointment" onAction="#handleDelete"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="View Details"       onAction="#handleViewDetails"/>
                </Menu>
            </MenuBar>

            <!-- App Title Bar -->
            <HBox styleClass="title-bar" alignment="CENTER_LEFT">
                <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                <Label text="Health Appointment Manager" styleClass="app-title"/>
            </HBox>

            <!-- Search + Filter bar (Proposal Section 9) -->
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="filter-bar">
                <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>

                <Label text="Search:" styleClass="filter-label"/>
                <TextField fx:id="searchField"
                           promptText="Patient name or doctor..."
                           prefWidth="220"
                           styleClass="search-field"/>

                <Separator orientation="VERTICAL"/>

                <Label text="Date:" styleClass="filter-label"/>
                <DatePicker fx:id="filterDate" prefWidth="150"/>

                <Label text="Status:" styleClass="filter-label"/>
                <ComboBox fx:id="filterStatus" prefWidth="130"/>

                <Button text="Apply Filter" onAction="#handleFilter"      styleClass="btn-primary"/>
                <Button text="Clear"        onAction="#handleClearFilter" styleClass="btn-secondary"/>
            </HBox>

        </VBox>
    </top>

    <!-- ===== Centre: Appointment TableView ================================ -->
    <center>
        <TableView fx:id="tableView" styleClass="appointment-table">
            <columns>
                <TableColumn fx:id="colId"          text="Appt. ID"     prefWidth="70"/>
                <TableColumn fx:id="colPatientName" text="Patient Name"  prefWidth="170"/>
                <TableColumn fx:id="colPhone"       text="Phone"         prefWidth="140"/>
                <TableColumn fx:id="colDate"        text="Date"          prefWidth="110"/>
                <TableColumn fx:id="colTime"        text="Time"          prefWidth="100"/>
                <TableColumn fx:id="colDoctor"      text="Doctor"        prefWidth="130"/>
                <TableColumn fx:id="colReason"      text="Reason"        prefWidth="140"/>
                <TableColumn fx:id="colStatus"      text="Status"        prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="No appointments found. Click Add Appointment to get started."/>
            </placeholder>
        </TableView>
    </center>

    <!-- ===== Bottom: Action buttons ======================================= -->
    <bottom>
        <HBox spacing="12" alignment="CENTER" styleClass="action-bar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Add Appointment"  onAction="#handleAdd"         styleClass="btn-primary"   prefWidth="145"/>
            <Button text="Edit Appointment" onAction="#handleUpdate"      styleClass="btn-secondary" prefWidth="145"/>
            <Button text="Delete"           onAction="#handleDelete"      styleClass="btn-danger"    prefWidth="110"/>
            <Button text="View Details"     onAction="#handleViewDetails" styleClass="btn-info"      prefWidth="120"/>
        </HBox>
    </bottom>

</BorderPane>