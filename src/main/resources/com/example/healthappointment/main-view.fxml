<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.healthappointment.controller.MainController"
            stylesheets="@styles.css">

    <!-- SIDEBAR -->
    <left>
        <HBox styleClass="side-shell">
            <VBox styleClass="menu-rail" alignment="TOP_CENTER">
                <padding><Insets top="16" left="8" right="8"/></padding>
                <Button fx:id="hamburgerButton" onAction="#handleToggleSidebar" styleClass="hamburger-btn" focusTraversable="false">
                    <graphic>
                        <VBox spacing="4" alignment="CENTER">
                            <Region fx:id="lineTop" styleClass="hamburger-line"/>
                            <Region fx:id="lineMiddle" styleClass="hamburger-line"/>
                            <Region fx:id="lineBottom" styleClass="hamburger-line"/>
                        </VBox>
                    </graphic>
                </Button>
            </VBox>

            <VBox fx:id="sidebar" styleClass="sidebar" spacing="15" visible="false" managed="false">
                <padding><Insets top="25" left="15" right="15" bottom="18"/></padding>

                <Label text="Appoinment" styleClass="logo"/>

                <Separator/>

                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Button fx:id="btnAdd" text="Add Appoinment" onAction="#handleAdd" styleClass="nav-btn" maxWidth="1.7976931348623157E308"/>
                    <Region fx:id="underlineAdd" styleClass="nav-underline"/>
                </VBox>
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Button fx:id="btnEdit" text="Edit Appoinment" onAction="#handleUpdate" styleClass="nav-btn" maxWidth="1.7976931348623157E308"/>
                    <Region fx:id="underlineEdit" styleClass="nav-underline"/>
                </VBox>
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Button fx:id="btnDelete" text="Delet Appoinment" onAction="#handleDelete" styleClass="nav-btn" maxWidth="1.7976931348623157E308"/>
                    <Region fx:id="underlineDelete" styleClass="nav-underline"/>
                </VBox>
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Button fx:id="btnDetails" text="View Details" onAction="#handleViewDetails" styleClass="nav-btn" maxWidth="1.7976931348623157E308"/>
                    <Region fx:id="underlineDetails" styleClass="nav-underline"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Button fx:id="btnExit" text="Exit" onAction="#handleExit" styleClass="exit-btn" maxWidth="1.7976931348623157E308"/>
                    <Region fx:id="underlineExit" styleClass="nav-underline, exit-underline"/>
                </VBox>
            </VBox>
        </HBox>
    </left>

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="top-bar">
            <padding><Insets top="10" left="20" right="20"/></padding>

            <Region HBox.hgrow="ALWAYS"/>
            <Label text="HealthCare" styleClass="title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="15" styleClass="content-area">
            <padding><Insets top="15" left="15" right="15" bottom="15"/></padding>

            <!-- FILTER CARD -->
            <HBox spacing="10" styleClass="card">
                <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS"/>
                <DatePicker fx:id="filterDate"/>
                <ComboBox fx:id="filterStatus" promptText="Status"/>

                <Button text="Apply" onAction="#handleFilter" styleClass="btn-primary"/>
                <Button text="Clear" onAction="#handleClearFilter" styleClass="btn-secondary"/>
            </HBox>

            <!-- TABLE CARD -->
            <VBox styleClass="card" VBox.vgrow="ALWAYS">
                <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="70"/>
                        <TableColumn fx:id="colPatientName" text="Patient"/>
                        <TableColumn fx:id="colPhone" text="Phone"/>
                        <TableColumn fx:id="colDate" text="Date"/>
                        <TableColumn fx:id="colTime" text="Time"/>
                        <TableColumn fx:id="colDoctor" text="Doctor"/>
                        <TableColumn fx:id="colReason" text="Reason"/>
                        <TableColumn fx:id="colStatus" text="Status"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>