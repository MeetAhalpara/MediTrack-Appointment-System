<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.healthappointment.controller.AppointmentFormController"
      stylesheets="@styles.css"
      spacing="10">

    <padding><Insets top="20" left="20" right="20"/></padding>

    <Label fx:id="lblTitle" text="Add Appointment" styleClass="form-title"/>

    <GridPane hgap="10" vgap="6">

        <Label text="Name"/>
        <TextField fx:id="fieldName" GridPane.columnIndex="1"/>
        <Label fx:id="lblErrName" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Phone" GridPane.rowIndex="2"/>
        <TextField fx:id="fieldPhone" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label fx:id="lblErrPhone" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Date" GridPane.rowIndex="4"/>
        <DatePicker fx:id="fieldDate" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        <Label fx:id="lblErrDate" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Time" GridPane.rowIndex="6"/>
        <ComboBox fx:id="fieldTime" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
        <Label fx:id="lblErrTime" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

        <Label text="Doctor" GridPane.rowIndex="8"/>
        <ComboBox fx:id="fieldDoctor" GridPane.columnIndex="1" GridPane.rowIndex="8"/>
        <Label fx:id="lblErrDoctor" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

        <Label text="Reason" GridPane.rowIndex="10"/>
        <TextField fx:id="fieldReason" GridPane.columnIndex="1" GridPane.rowIndex="10"/>
        <Label fx:id="lblErrReason" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

        <Label text="Status" GridPane.rowIndex="12"/>
        <ComboBox fx:id="fieldStatus" GridPane.columnIndex="1" GridPane.rowIndex="12"/>

    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancel" onAction="#handleCancel"/>
        <Button text="Save" onAction="#handleSave" styleClass="btn-primary"/>
    </HBox>

</VBox>