<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="root" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.healthappointment.controller.AppointmentFormController"
      stylesheets="@styles.css"
    styleClass="popup-root"
      alignment="TOP_CENTER"
      spacing="10">

    <padding><Insets top="20" left="20" right="20"/></padding>

    <VBox styleClass="popup-form-shell" maxWidth="920.0" fillWidth="true" spacing="10">
        <Label fx:id="lblTitle" text="Add Appointment" styleClass="form-title"/>
        <HBox spacing="4" alignment="CENTER_LEFT" styleClass="important-note">
            <Label text="Fields marked" />
            <Label text="*" styleClass="mandatory-star" />
            <Label text="are mandatory and must be filled." wrapText="true" />
        </HBox>

        <GridPane styleClass="popup-form-grid" hgap="15" vgap="10" maxWidth="Infinity">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="90.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="220.0" prefWidth="520.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="15.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>

            <HBox spacing="3" alignment="CENTER_LEFT">
                <Label text="Name" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <TextField fx:id="fieldName" GridPane.columnIndex="1" maxWidth="Infinity"/>
            <Label fx:id="lblErrName" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <HBox spacing="3" GridPane.rowIndex="2" alignment="CENTER_LEFT">
                <Label text="Phone" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <TextField fx:id="fieldPhone" GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"/>
            <Label fx:id="lblErrPhone" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <HBox spacing="3" GridPane.rowIndex="4" alignment="CENTER_LEFT">
                <Label text="Date" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <DatePicker fx:id="fieldDate" GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity"/>
            <Label fx:id="lblErrDate" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

            <HBox spacing="3" GridPane.rowIndex="6" alignment="CENTER_LEFT">
                <Label text="Time" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <ComboBox fx:id="fieldTime" GridPane.columnIndex="1" GridPane.rowIndex="6" maxWidth="Infinity"/>
            <Label fx:id="lblErrTime" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

            <HBox spacing="3" GridPane.rowIndex="8" alignment="CENTER_LEFT">
                <Label text="Doctor" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <ComboBox fx:id="fieldDoctor" GridPane.columnIndex="1" GridPane.rowIndex="8" maxWidth="Infinity"/>
            <Label fx:id="lblErrDoctor" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="9"/>

            <HBox spacing="3" GridPane.rowIndex="10" alignment="CENTER_LEFT">
                <Label text="Reason" styleClass="form-label"/>
                <Label text="*" styleClass="mandatory-star"/>
            </HBox>
            <TextField fx:id="fieldReason" GridPane.columnIndex="1" GridPane.rowIndex="10" maxWidth="Infinity"/>
            <Label fx:id="lblErrReason" styleClass="error-label" GridPane.columnIndex="1" GridPane.rowIndex="11"/>

            <Label text="Status" GridPane.rowIndex="12" styleClass="form-label"/>
            <ComboBox fx:id="fieldStatus" GridPane.columnIndex="1" GridPane.rowIndex="12" maxWidth="Infinity"/>

        </GridPane>

        <HBox spacing="10" alignment="CENTER" styleClass="popup-form-actions">
            <Button text="Save" onAction="#handleSave" styleClass="btn-primary popup-save-btn"/>
            <Button text="Cancel" onAction="#handleCancel" styleClass="popup-cancel-btn"/>
        </HBox>
    </VBox>

</VBox>