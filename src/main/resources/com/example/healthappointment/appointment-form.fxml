<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true"
            fitToHeight="true"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.healthappointment.controller.AppointmentFormController"
            stylesheets="@styles.css"
            styleClass="popup-root">

    <content>
        <VBox fx:id="root" alignment="TOP_CENTER" spacing="10">
            <padding>
                <Insets top="20" left="20" right="20"/>
            </padding>

            <VBox styleClass="popup-form-shell" maxWidth="920.0" fillWidth="true" spacing="10">

                <Label fx:id="lblTitle"
                       text="Add Appointment"
                       styleClass="form-title"
                       accessibleText="Appointment form"
                       accessibleHelp="Use this form to add or edit an appointment"/>

                <HBox spacing="4" alignment="CENTER_LEFT" styleClass="important-note">
                    <Label text="Fields marked" />
                    <Label text="*" styleClass="mandatory-star" />
                    <Label text="are mandatory and must be filled." wrapText="true" />
                </HBox>

                <GridPane styleClass="popup-form-grid" hgap="15" vgap="10">

                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- NAME -->
                    <HBox spacing="3">
                        <Label fx:id="lblName" text="_Name" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <TextField fx:id="fieldName"
                               GridPane.columnIndex="1"
                               accessibleText="Patient name"
                               accessibleHelp="Enter full patient name"/>
                    <Label fx:id="lblErrName" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                    <!-- PHONE -->
                    <HBox spacing="3" GridPane.rowIndex="2">
                        <Label fx:id="lblPhone" text="_Phone" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <TextField fx:id="fieldPhone"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"
                               accessibleText="Phone number"
                               accessibleHelp="Enter phone number"/>
                    <Label fx:id="lblErrPhone" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                    <!-- DATE -->
                    <HBox spacing="3" GridPane.rowIndex="4">
                        <Label fx:id="lblDate" text="_Date" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <DatePicker fx:id="fieldDate"
                                GridPane.columnIndex="1" GridPane.rowIndex="4"
                                accessibleText="Appointment date"
                                accessibleHelp="Select appointment date"/>
                    <Label fx:id="lblErrDate" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                    <!-- TIME -->
                    <HBox spacing="3" GridPane.rowIndex="6">
                        <Label fx:id="lblTime" text="_Time" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <ComboBox fx:id="fieldTime"
                              GridPane.columnIndex="1" GridPane.rowIndex="6"
                              accessibleText="Appointment time"/>
                    <Label fx:id="lblErrTime" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                    <!-- DOCTOR -->
                    <HBox spacing="3" GridPane.rowIndex="8">
                        <Label fx:id="lblDoctor" text="_Doctor" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <ComboBox fx:id="fieldDoctor"
                              GridPane.columnIndex="1" GridPane.rowIndex="8"
                              accessibleText="Doctor"/>
                    <Label fx:id="lblErrDoctor" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="9"/>

                    <!-- REASON -->
                    <HBox spacing="3" GridPane.rowIndex="10">
                        <Label fx:id="lblReason" text="_Reason" styleClass="form-label"/>
                        <Label text="*" styleClass="mandatory-star"/>
                    </HBox>
                    <TextField fx:id="fieldReason"
                               GridPane.columnIndex="1" GridPane.rowIndex="10"
                               accessibleText="Reason for appointment"/>
                    <Label fx:id="lblErrReason" styleClass="error-label"
                           GridPane.columnIndex="1" GridPane.rowIndex="11"/>

                    <!-- STATUS -->
                    <Label fx:id="lblStatus" text="_Status"
                           GridPane.rowIndex="12"
                           styleClass="form-label"/>
                    <ComboBox fx:id="fieldStatus"
                              GridPane.columnIndex="1" GridPane.rowIndex="12"
                              accessibleText="Appointment status"/>
                </GridPane>

                <!-- BUTTONS -->
                <HBox spacing="10" alignment="CENTER" styleClass="popup-form-actions">
                    <Button fx:id="saveButton"
                            id="saveButton"
                            text="Save"
                            onAction="#handleSave"
                            styleClass="btn-save"
                            accessibleText="Save appointment"/>

                    <Button fx:id="cancelButton"
                            id="cancelButton"
                            text="Cancel"
                            onAction="#handleCancel"
                            styleClass="btn-cancel"
                            accessibleText="Cancel form"/>
                </HBox>

            </VBox>
        </VBox>
    </content>
</ScrollPane>