<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.healthappointment.controller.DetailController"
      stylesheets="@styles.css"
      spacing="12">

    <padding><Insets top="20" left="20" right="20"/></padding>

    <Label text="Appointment Details" styleClass="form-title"/>

    <GridPane hgap="10" vgap="10">

        <Label text="ID"/>
        <Label fx:id="lblAppointmentId" GridPane.columnIndex="1"/>

        <Label text="Name" GridPane.rowIndex="1"/>
        <Label fx:id="lblPatientName" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Phone" GridPane.rowIndex="2"/>
        <Label fx:id="lblPhone" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Date" GridPane.rowIndex="3"/>
        <Label fx:id="lblDate" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Time" GridPane.rowIndex="4"/>
        <Label fx:id="lblTime" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Label text="Doctor" GridPane.rowIndex="5"/>
        <Label fx:id="lblDoctor" GridPane.columnIndex="1" GridPane.rowIndex="5"/>

        <Label text="Reason" GridPane.rowIndex="6"/>
        <Label fx:id="lblReason" GridPane.columnIndex="1" GridPane.rowIndex="6"/>

        <Label text="Status" GridPane.rowIndex="7"/>
        <Label fx:id="lblStatus" GridPane.columnIndex="1" GridPane.rowIndex="7"/>

    </GridPane>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Close" onAction="#handleClose"/>
    </HBox>

</VBox>