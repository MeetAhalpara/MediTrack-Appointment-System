<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.healthappointment.controller.GetStartedController"
           stylesheets="@styles.css"
           styleClass="get-started-root"
           alignment="CENTER">

    <VBox fx:id="card" alignment="TOP_CENTER" spacing="18" styleClass="get-started-card" maxWidth="580.0" minWidth="280.0">
        <padding>
            <Insets top="32" right="32" bottom="32" left="32"/>
        </padding>

        <Label fx:id="titleLabel" text="HealthCare" styleClass="get-started-title"/>
        <Label fx:id="subtitleLabel" text="Welcome to Health Appointment Manager" styleClass="get-started-subtitle" wrapText="true"/>
        <Label fx:id="descriptionLabel" text="Track appointments, apply smart filters, and manage patient visits in one place."
               styleClass="get-started-description"
               wrapText="true"/>

        <Button fx:id="getStartedButton" text="Get Started" onAction="#handleGetStarted" styleClass="get-started-button"/>
    </VBox>

</StackPane>

